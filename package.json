{
  "name": "tdsh-desktop",
  "version": "0.1.27",
  "description": "TDSH — 团团的 DeepSeek 桌面壳：把 DeepSeek Harness 的 Web 界面装进原生桌面窗口（attach-or-spawn，无边框 + Hanako 式交互）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "publish": "electron-builder --win --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tuantuan0218/TDSH.git"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}


