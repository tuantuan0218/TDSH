{
  "name": "dsh-plugin-everything",
  "version": "0.1.0",
  "description": "双通道快速文件索引搜索工具 — Everything(es.exe) + 自包含 dsearch 兜底",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "everything", "search", "file-index"],
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"]
}