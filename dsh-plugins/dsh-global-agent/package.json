{
  "name": "dsh-global-agent",
  "version": "0.1.0",
  "description": "Global AGENTS.md editor: set user-global agent instructions with hot-reload.",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "plugin", "agent", "agents"],
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"]
}